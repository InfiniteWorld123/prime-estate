{
  "name": "prime-estate",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
	"scripts": {
		"dev": "vite dev --port 3000",
		"db:migrate": "bun src/backend/db/migrate.ts",
		"db:seed": "bun src/backend/db/seed/seed.ts",
		"db:seed:clear": "bun src/backend/db/seed/seed.ts --clear",
		"db:seed:dry": "bun src/backend/db/seed/seed.ts --dry-run",
		"db:seed:validate": "bun src/backend/db/seed/seed.ts --validate",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.545.0",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.17.2",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
